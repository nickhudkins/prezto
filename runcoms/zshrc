# Auto-complete!
autoload -U compinit
compinit -u

download_bundle() {
    # Check if both arguments are provided
    if [ $# -ne 2 ]; then
        echo "Usage: download_bundle <LOOP_NAME> <GIT_SHA>"
        echo "Example: download_bundle production abc123def456"
        return 1
    fi

    local LOOP_NAME="$1"
    local GIT_SHA="$2"

    # Construct the download URL
    local URL="https://a0.muscache.com/airbnb/${LOOP_NAME}-${GIT_SHA}-metro-client-build-artifact.tar.gz"

    # Construct the output filename
    local OUTPUT_FILE="${LOOP_NAME}-${GIT_SHA}.tar.gz"

    echo "Downloading from: $URL"
    echo "Saving as: $OUTPUT_FILE"

    # Download the file using curl
    if curl -L -o "$OUTPUT_FILE" "$URL"; then
        echo "Download completed successfully: $OUTPUT_FILE"
    else
        echo "Download failed!" >&2
        return 1
    fi
}

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Some interesting `clear` behavior because I like me
# some extra vertical space.
function precmd() {
  # Print a newline before the prompt, unless it's the
  # first prompt in the process.
  if [ -z "$NEW_LINE_BEFORE_PROMPT" ]; then
    NEW_LINE_BEFORE_PROMPT=1
  elif [ "$NEW_LINE_BEFORE_PROMPT" -eq 1 ]; then
    echo
  fi
}
alias clear="unset NEW_LINE_BEFORE_PROMPT && clear"

export NVM_DIR="$HOME/.nvm"

[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# Any functions etc....
[ -s "$HOME/utils.zsh" ] && source $HOME/utils.zsh

# Make iTerm2 Extra Special
[ -f "$HOME/.iterm2_shell_integration.zsh" ] && source $HOME/.iterm2_shell_integration.zsh

source <(yak completion zsh)
source <(kubectl completion zsh)

if [[ $(uname) == 'Darwin' ]]; then
  source "${ZDOTDIR:-$HOME}/.zshrc.mac"
fi

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
[ -d "$HOME/repos/migration-tools/bin" ] && export PATH="$HOME/repos/migration-tools/bin:$PATH"
[ -s "$HOME/.local/bin/env" ] && source "$HOME/.local/bin/env"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if command -v pyenv &>/dev/null || [[ -d "$PYENV_ROOT/bin" ]]; then
  export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"
  export PYENV_SHELL=zsh
  if [[ $(uname) == 'Darwin' ]]; then
    _pyenv_completions="$(brew --prefix pyenv 2>/dev/null)/completions/pyenv.zsh"
    [ -s "$_pyenv_completions" ] && source "$_pyenv_completions"
    unset _pyenv_completions
  fi
  command pyenv rehash 2>/dev/null
  pyenv() {
    local command=${1:-}
    [ "$#" -gt 0 ] && shift
    case "$command" in
    rehash|shell)
      eval "$(pyenv "sh-$command" "$@")"
      ;;
    *)
      command pyenv "$command" "$@"
      ;;
    esac
  }
fi

alias airchat='airchat claude --api-mode enterprise'
